{
  "title": "Corporate Registry - Ray platform",
  "uid": "corpreg-platform",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "ray",
    "karpenter"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "RayJobs by deployment status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (deployment_status) (kuberay_job_deployment_status)",
          "legendFormat": "{{deployment_status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ray nodes (active)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (ray_io_cluster) (ray_cluster_active_nodes)",
          "legendFormat": "{{ray_io_cluster}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending / infeasible scheduling",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(ray_scheduler_unscheduleable_tasks) or vector(0)",
          "legendFormat": "unschedulable",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Object store used vs available",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (ray_io_cluster) (ray_object_store_used_memory)",
          "legendFormat": "{{ray_io_cluster}} used",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Object store spilled to disk",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (ray_io_cluster) (ray_object_store_memory{Location=\"SPILLED\"})",
          "legendFormat": "{{ray_io_cluster}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node memory utilisation",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (instance) (ray_node_mem_used / ray_node_mem_total)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Karpenter NodePool CPU usage / limit",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "karpenter_nodepools_usage{resource_type=\"cpu\"} / karpenter_nodepools_limit{resource_type=\"cpu\"}",
          "legendFormat": "{{nodepool}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Spot interruption messages",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (message_type) (increase(karpenter_interruption_received_messages_total[15m]))",
          "legendFormat": "{{message_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ray pods by phase",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"ray\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    }
  ]
}