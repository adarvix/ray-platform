# Data-plane guardrails: the lake is private, versioned, KMS-encrypted; images are immutable.
mock_provider "aws" {
  mock_data "aws_caller_identity" {
    defaults = { account_id = "123456789012" }
  }
  # Mocked computed values are random strings; give ARN-typed attributes valid ARNs.
  mock_resource "aws_kms_key" {
    defaults = { arn = "arn:aws:kms:ap-south-1:123456789012:key/00000000-0000-0000-0000-000000000000" }
  }
  mock_resource "aws_s3_bucket" {
    defaults = { arn = "arn:aws:s3:::corpreg-dev-lake-123456789012" }
  }
  mock_resource "aws_secretsmanager_secret" {
    defaults = { arn = "arn:aws:secretsmanager:ap-south-1:123456789012:secret:mock" }
  }
}
# random is local-only (no cloud calls), so the real provider is used: mocks cannot do ephemeral resources.

run "lake_and_registry_guardrails" {
  command = apply # mocked AWS: nothing is created; apply resolves computed values (bucket ARN)

  assert {
    condition = alltrue([
      aws_s3_bucket_public_access_block.lake.block_public_acls,
      aws_s3_bucket_public_access_block.lake.block_public_policy,
      aws_s3_bucket_public_access_block.lake.ignore_public_acls,
      aws_s3_bucket_public_access_block.lake.restrict_public_buckets,
    ])
    error_message = "lake bucket must block every form of public access"
  }
  assert {
    condition     = aws_s3_bucket_versioning.lake.versioning_configuration[0].status == "Enabled"
    error_message = "lake bucket must be versioned (recovery from bad writes)"
  }
  assert {
    condition     = one(one(aws_s3_bucket_server_side_encryption_configuration.lake.rule).apply_server_side_encryption_by_default).sse_algorithm == "aws:kms"
    error_message = "lake must default to SSE-KMS"
  }
  assert {
    condition     = strcontains(aws_s3_bucket_policy.lake.policy, "aws:SecureTransport")
    error_message = "bucket policy must deny non-TLS access"
  }
  assert {
    condition     = aws_kms_key.data.enable_key_rotation
    error_message = "KMS key rotation must be on"
  }
  assert {
    condition     = aws_ecr_repository.pipeline.image_tag_mutability == "IMMUTABLE"
    error_message = "image tags must be immutable (a tag always means the same bits)"
  }
  assert {
    condition     = length(aws_secretsmanager_secret_version.ray_dashboard_token) == 1
    error_message = "dashboard token is generated by default (write-only, never in state)"
  }
  assert {
    condition     = aws_glue_catalog_database.registry.location_uri == "s3://corpreg-dev-lake-123456789012/warehouse/corporate_registry.db"
    error_message = "Iceberg warehouse must live under the lake's warehouse/ prefix (the job role is scoped to it)"
  }
}
